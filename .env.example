# Firebase
FIREBASE_CREDENTIALS_PATH=path/to/service-account.json

# Gemini
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.0-flash-lite

# Classifier
PRELOAD_MODEL=true
MODEL_DIR=models
MODEL_FILE=best_weights.pt
BULLY_THRESHOLD=0.6
# Endpoint diagnostik /api/v1/cek; biarkan false di produksi.
DEBUG_INFERENCE=false

# Monitored apps
MONITORED_PACKAGES=com.whatsapp,com.whatsapp.w4b,com.instagram.android

# Rate limiting
RATE_LIMIT_CLASSIFY=30/minute
RATE_LIMIT_PAIRING_UID=10/minute;60/hour
RATE_LIMIT_PAIRING_IP=30/minute;200/hour

# Logging
LOG_LEVEL=INFO
